{
  "name": "@linagora/qrg-bundle",
  "version": "0.0.0",
  "private": true,
  "description": "QRG profile bundle for DSH: mounts the qrg-router host row, inserts its tools row in the standard and ptc presets, and cuts the flows to DeepSeek",
  "license": "AGPL-3.0-only",
  "type": "module",
  "exports": {
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./profile.patch.yml": "./profile.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "cordis.patch.yml",
    "profile.patch.yml"
  ],
  "engines": {
    "dsh": "0.2.1-alpha.4"
  },
  "dsh": {
    "bundle": {
      "patch": [
        "./cordis.patch.yml",
        "./profile.patch.yml"
      ]
    }
  },
  "dependencies": {
    "@linagora/qrg-router": "workspace:*"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.5-alpha.2",
    "@deepseek-ai/cordis-plugin-loader": "1.0.6-alpha.2",
    "@deepseek-ai/dsh": "0.2.1-alpha.4",
    "@deepseek-ai/dsh-agent": "0.2.1-alpha.4",
    "@deepseek-ai/dsh-agent-preset-registry": "0.2.1-alpha.4",
    "@deepseek-ai/dsh-api-session-controller": "0.2.1-alpha.4",
    "@deepseek-ai/dsh-app-boot": "0.2.1-alpha.4",
    "@deepseek-ai/dsh-cmdline": "0.2.1-alpha.4",
    "@deepseek-ai/dsh-loader-smoke": "0.2.1-alpha.4",
    "@deepseek-ai/dsh-storage-domain": "0.2.1-alpha.4",
    "@deepseek-ai/dsh-subagent": "0.2.1-alpha.4",
    "@deepseek-ai/dsh-web-app": "0.2.1-alpha.4"
  }
}
